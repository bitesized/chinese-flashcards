# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Data build: tsconfig.build-data.json compiles pipeline/ and src/domain/
# in place (see pipeline/build-data.ts's docstring for why) so their
# import.meta.url-relative paths into data/ resolve correctly. The .ts
# sources are committed; the compiled .js siblings are not.
pipeline/**/*.js
src/domain/**/*.js

# Test / tooling output
coverage/
playwright-report/
test-results/
.eslintcache

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
